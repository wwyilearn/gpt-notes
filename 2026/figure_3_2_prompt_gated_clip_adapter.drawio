      <root>
        <mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" parent="1" value="图 3-2  Prompt-Gated CLIP-Adapter 方法框架图" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#DCE9F7;strokeColor=#8AA9C7;strokeWidth=1.6;fontSize=22;fontStyle=1;fontColor=#1F2D3D;align=center;verticalAlign=middle;" vertex="1"><mxGeometry x="35" y="18" width="1130" height="48" as="geometry" /></mxCell><mxCell id="p_left" parent="1" value="视觉分支" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F4F6F8;strokeColor=#C3CBD4;strokeWidth=1.6;fontSize=18;fontStyle=1;fontColor=#1F2D3D;align=center;verticalAlign=top;spacingTop=10;" vertex="1"><mxGeometry x="40" y="95" width="530" height="610" as="geometry" /></mxCell><mxCell id="p_right" parent="1" value="文本提示词分支与门控分支" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F4F6F8;strokeColor=#C3CBD4;strokeWidth=1.6;fontSize=18;fontStyle=1;fontColor=#1F2D3D;align=center;verticalAlign=top;spacingTop=10;" vertex="1"><mxGeometry x="610" y="95" width="555" height="610" as="geometry" /></mxCell><mxCell id="img_in" parent="1" value="输入全脸图像&lt;br/&gt;&lt;font style=&#x27;font-size:12px;font-weight:0;&#x27;&gt;224×224&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=9;fillColor=#EAF3FF;strokeColor=#8FAFD1;strokeWidth=1.3;fontSize=14;fontStyle=1;fontColor=#24313F;align=center;verticalAlign=middle;" vertex="1"><mxGeometry x="95" y="150" width="150" height="62" as="geometry" /></mxCell><mxCell id="clip_img" parent="1" value="Frozen CLIP image encoder&lt;br/&gt;&lt;font style=&#x27;font-size:12px;font-weight:0;&#x27;&gt;ViT-B/32&lt;br/&gt;参数冻结&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=9;fillColor=#F7FCF5;strokeColor=#A9C7A3;strokeWidth=1.3;fontSize=14;fontStyle=1;fontColor=#24313F;align=center;verticalAlign=middle;" vertex="1"><mxGeometry x="90" y="255" width="160" height="74" as="geometry" /></mxCell><mxCell id="img_feat" parent="1" value="图像特征&lt;br/&gt;&lt;font style=&#x27;font-size:12px;font-weight:0;&#x27;&gt;image feature&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=9;fillColor=#F7FCF5;strokeColor=#A9C7A3;strokeWidth=1.3;fontSize=14;fontStyle=1;fontColor=#24313F;align=center;verticalAlign=middle;" vertex="1"><mxGeometry x="95" y="372" width="150" height="56" as="geometry" /></mxCell><mxCell id="adapter" parent="1" value="轻量特征适配器&lt;br/&gt;&lt;font style=&#x27;font-size:12px;font-weight:0;&#x27;&gt;Linear → ReLU → Dropout → Linear&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=9;fillColor=#F7FCF5;strokeColor=#A9C7A3;strokeWidth=1.3;fontSize=14;fontStyle=1;fontColor=#24313F;align=center;verticalAlign=middle;" vertex="1"><mxGeometry x="300" y="255" width="210" height="74" as="geometry" /></mxCell><mxCell id="adapt_feat" parent="1" value="适配器特征&lt;br/&gt;&lt;font style=&#x27;font-size:12px;font-weight:0;&#x27;&gt;adapter feature&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=9;fillColor=#F7FCF5;strokeColor=#A9C7A3;strokeWidth=1.3;fontSize=14;fontStyle=1;fontColor=#24313F;align=center;verticalAlign=middle;" vertex="1"><mxGeometry x="330" y="372" width="150" height="56" as="geometry" /></mxCell><mxCell id="gated_feat" parent="1" value="门控后的适配器特征&lt;br/&gt;&lt;font style=&#x27;font-size:12px;font-weight:0;&#x27;&gt;gate ⊙ adapter feature&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=9;fillColor=#FFF7F8;strokeColor=#D2A5AE;strokeWidth=1.3;fontSize=14;fontStyle=1;fontColor=#24313F;align=center;verticalAlign=middle;" vertex="1"><mxGeometry x="300" y="490" width="210" height="62" as="geometry" /></mxCell><mxCell id="fusion" parent="1" value="特征融合&lt;br/&gt;&lt;font style=&#x27;font-size:12px;font-weight:0;&#x27;&gt;image feature + α·gated adapter feature&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=9;fillColor=#F8F5FF;strokeColor=#B6A6D8;strokeWidth=1.3;fontSize=14;fontStyle=1;fontColor=#24313F;align=center;verticalAlign=middle;" vertex="1"><mxGeometry x="180" y="600" width="255" height="64" as="geometry" /></mxCell><mxCell id="prompts" parent="1" value="固定提示词集合&lt;br/&gt;&lt;font style=&#x27;font-size:12px;font-weight:0;&#x27;&gt;方向提示词 + 头眼关系提示词&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=9;fillColor=#FFF7E8;strokeColor=#D0B071;strokeWidth=1.3;fontSize=14;fontStyle=1;fontColor=#24313F;align=center;verticalAlign=middle;" vertex="1"><mxGeometry x="670" y="150" width="190" height="62" as="geometry" /></mxCell><mxCell id="token" parent="1" value="文本编码 / Tokenize" style="rounded=1;whiteSpace=wrap;html=1;arcSize=9;fillColor=#FFF7E8;strokeColor=#D0B071;strokeWidth=1.3;fontSize=14;fontStyle=1;fontColor=#24313F;align=center;verticalAlign=middle;" vertex="1"><mxGeometry x="710" y="238" width="110" height="42" as="geometry" /></mxCell><mxCell id="clip_text" parent="1" value="Frozen CLIP text encoder&lt;br/&gt;&lt;font style=&#x27;font-size:12px;font-weight:0;&#x27;&gt;参数冻结&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=9;fillColor=#FFF7E8;strokeColor=#D0B071;strokeWidth=1.3;fontSize=14;fontStyle=1;fontColor=#24313F;align=center;verticalAlign=middle;" vertex="1"><mxGeometry x="670" y="305" width="190" height="62" as="geometry" /></mxCell><mxCell id="text_feat" parent="1" value="提示词文本特征&lt;br/&gt;&lt;font style=&#x27;font-size:12px;font-weight:0;&#x27;&gt;text features&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=9;fillColor=#FFF7E8;strokeColor=#D0B071;strokeWidth=1.3;fontSize=14;fontStyle=1;fontColor=#24313F;align=center;verticalAlign=middle;" vertex="1"><mxGeometry x="690" y="400" width="150" height="54" as="geometry" /></mxCell><mxCell id="sim" parent="1" value="提示词相似度计算&lt;br/&gt;&lt;font style=&#x27;font-size:12px;font-weight:0;&#x27;&gt;image feature × text features&lt;br/&gt;得到 prompt similarity&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=9;fillColor=#FFF7F8;strokeColor=#D2A5AE;strokeWidth=1.3;fontSize=14;fontStyle=1;fontColor=#24313F;align=center;verticalAlign=middle;" vertex="1"><mxGeometry x="905" y="325" width="205" height="74" as="geometry" /></mxCell><mxCell id="gate_net" parent="1" value="门控网络&lt;br/&gt;&lt;font style=&#x27;font-size:12px;font-weight:0;&#x27;&gt;Linear → ReLU → Dropout → Linear → Sigmoid&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=9;fillColor=#FFF7F8;strokeColor=#D2A5AE;strokeWidth=1.3;fontSize=14;fontStyle=1;fontColor=#24313F;align=center;verticalAlign=middle;" vertex="1"><mxGeometry x="900" y="445" width="215" height="74" as="geometry" /></mxCell><mxCell id="gate_vec" parent="1" value="门控向量&lt;br/&gt;&lt;font style=&#x27;font-size:12px;font-weight:0;&#x27;&gt;gate vector&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=9;fillColor=#FFF7F8;strokeColor=#D2A5AE;strokeWidth=1.3;fontSize=14;fontStyle=1;fontColor=#24313F;align=center;verticalAlign=middle;" vertex="1"><mxGeometry x="935" y="555" width="145" height="54" as="geometry" /></mxCell><mxCell id="mlp" parent="1" value="MLP 回归头" style="rounded=1;whiteSpace=wrap;html=1;arcSize=9;fillColor=#F8F5FF;strokeColor=#B6A6D8;strokeWidth=1.3;fontSize=14;fontStyle=1;fontColor=#24313F;align=center;verticalAlign=middle;" vertex="1"><mxGeometry x="445" y="735" width="150" height="54" as="geometry" /></mxCell><mxCell id="out" parent="1" value="预测输出&lt;br/&gt;&lt;font style=&#x27;font-size:12px;font-weight:0;&#x27;&gt;predicted yaw / pitch&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=9;fillColor=#EAF3FF;strokeColor=#8FAFD1;strokeWidth=1.3;fontSize=14;fontStyle=1;fontColor=#24313F;align=center;verticalAlign=middle;" vertex="1"><mxGeometry x="640" y="735" width="175" height="54" as="geometry" /></mxCell><mxCell id="note1" parent="1" value="视觉分支负责提取全脸图像特征，并通过 adapter 学习任务相关的轻量特征修正" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#C8D0D8;strokeWidth=1.0;fontSize=12;fontColor=#44515E;align=center;verticalAlign=middle;" vertex="1"><mxGeometry x="70" y="95" width="470" height="34" as="geometry" /></mxCell><mxCell id="note2" parent="1" value="提示词相似度不直接输入回归头，而是用于生成门控向量，间接调节适配器特征强度" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#C8D0D8;strokeWidth=1.0;fontSize=12;fontColor=#44515E;align=center;verticalAlign=middle;" vertex="1"><mxGeometry x="635" y="95" width="505" height="34" as="geometry" /></mxCell><mxCell id="note3" parent="1" value="该结构既保留原始 CLIP 视觉特征，又利用固定提示词提供有限语义辅助" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#C8D0D8;strokeWidth=1.0;fontSize=12;fontColor=#44515E;align=center;verticalAlign=middle;" vertex="1"><mxGeometry x="300" y="815" width="600" height="34" as="geometry" /></mxCell><mxCell id="e1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#333333;strokeWidth=1.8;endArrow=block;endFill=1;" edge="1" source="img_in" target="clip_img"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#333333;strokeWidth=1.8;endArrow=block;endFill=1;" edge="1" source="clip_img" target="img_feat"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e3" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#4D6F91;strokeWidth=1.8;endArrow=block;endFill=1;" edge="1" source="img_feat" target="adapter"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e4" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#4D6F91;strokeWidth=1.8;endArrow=block;endFill=1;" edge="1" source="adapter" target="adapt_feat"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e5" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#4D6F91;strokeWidth=1.8;endArrow=block;endFill=1;" edge="1" source="adapt_feat" target="gated_feat"><mxGeometry relative="1" as="