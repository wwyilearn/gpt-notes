      <root>
        <mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="Figure 1.4  Technical Route of This Thesis" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=24;fontStyle=1;fontColor=#24313F;" parent="1" vertex="1"><mxGeometry x="300" y="20" width="520" height="30" as="geometry" /></mxCell><mxCell id="sub" value="CLIP-based 3D gaze estimation with progressive model design, ablation, and conclusion analysis" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=14;fontColor=#4B5B6B;" parent="1" vertex="1"><mxGeometry x="220" y="52" width="680" height="22" as="geometry" /></mxCell><mxCell id="g1" value="Stage 1  Data Preparation and Evaluation Setting" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;strokeColor=#8AA0B8;strokeWidth=1.5;fillColor=#F7F9FC;fontSize=13;fontStyle=1;fontColor=#24313F;align=center;verticalAlign=top;spacingTop=10;" parent="1" vertex="1"><mxGeometry x="40" y="95" width="1030" height="135" as="geometry" /></mxCell><mxCell id="g2" value="Stage 2  Progressive Model Design" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;strokeColor=#8AA0B8;strokeWidth=1.5;fillColor=#F7F9FC;fontSize=13;fontStyle=1;fontColor=#24313F;align=center;verticalAlign=top;spacingTop=10;" parent="1" vertex="1"><mxGeometry x="40" y="250" width="1030" height="165" as="geometry" /></mxCell><mxCell id="g3" value="Stage 3  Result Analysis and Thesis Conclusions" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;strokeColor=#8AA0B8;strokeWidth=1.5;fillColor=#F7F9FC;fontSize=13;fontStyle=1;fontColor=#24313F;align=center;verticalAlign=top;spacingTop=10;" parent="1" vertex="1"><mxGeometry x="40" y="435" width="1030" height="185" as="geometry" /></mxCell><mxCell id="d1" value="MPIIFaceGaze dataset&lt;br/&gt;Full-face image, pose, and gaze labels" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;strokeColor=#6C8EBF;strokeWidth=1.4;fillColor=#EAF2FF;fontSize=12;fontColor=#24313F;al