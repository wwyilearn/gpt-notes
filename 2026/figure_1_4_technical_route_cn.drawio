<mxfile host="app.diagrams.net" modified="2026-04-19T00:00:00.000Z" agent="ChatGPT" version="24.7.17">
  <diagram id="techroute_cn" name="中文技术路线图">
    <mxGraphModel dx="1386" dy="819" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" parent="1" value="基于 CLIP 与提示词的三维注视估计技术路线图" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#D9D9D9;strokeColor=#A6A6A6;strokeWidth=1.5;fontSize=22;fontStyle=1;fontColor=#111111;align=center;verticalAlign=middle;" vertex="1"><mxGeometry x="40" y="20" width="1120" height="46" as="geometry" /></mxCell><mxCell id="sec1" parent="1" value="研究背景与问题分析&lt;br/&gt;&lt;font style=&#x27;font-size:13px;color:#666666;&#x27;&gt;跨受试者泛化不足、复杂头部姿态、个体外观差异以及固定提示词表达能力有限&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#E6E6E6;strokeColor=#B7B7B7;strokeWidth=1.5;fontSize=18;fontStyle=1;fontColor=#111111;align=center;verticalAlign=middle;" vertex="1"><mxGeometry x="120" y="92" width="960" height="56" as="geometry" /></mxCell><mxCell id="p1" parent="1" value="数据与任务定义&lt;br/&gt;&lt;font style=&#x27;font-size:13px;font-weight:0;&#x27;&gt;MPIIFaceGaze 数据集&lt;br/&gt;全脸图像、pose、gaze 标签&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#F7F7F7;strokeColor=#B7B7B7;strokeWidth=1.5;fontSize=15;fontStyle=1;fontColor=#111111;align=center;verticalAlign=middle;" vertex="1"><mxGeometry x="50" y="190" width="280" height="74" as="geometry" /></mxCell><mxCell id="p2" parent="1" value="预处理与评估协议&lt;br/&gt;&lt;font style=&#x27;font-size:13px;font-weight:0;&#x27;&gt;224×224 输入尺寸&lt;br/&gt;CLIP 归一化&lt;br/&gt;简化版 LOPO（test_id=0/1/2）&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#F7F7F7;strokeColor=#B7B7B7;strokeWidth=1.5;fontSize=15;fontStyle=1;fontColor=#111111;align=center;verticalAlign=middle;" vertex="1"><mxGeometry x="460" y="190" width="280" height="74" as="geometry" /></mxCell><mxCell id="p3" parent="1" value="评价目标与指标&lt;br/&gt;&lt;font style=&#x27;font-size:13px;font-weight:0;&#x27;&gt;输出 yaw / pitch&lt;br/&gt;采用平均角度误差进行评估&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#F7F7F7;strokeColor=#B7B7B7;strokeWidth=1.5;fontSize=15;fontStyle=1;fontColor=#111111;align=center;verticalAlign=middle;" vertex="1"><mxGeometry x="870" y="190" width="240" height="74" as="geometry" /></mxCell><mxCell id="panel2" parent="1" value="递进式模型设计与实验框架" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#EDEDED;strokeColor=#B7B7B7;strokeWidth=1.5;fontSize=18;fontStyle=1;fontColor=#111111;align=center;verticalAlign=top;spacingTop=10;" vertex="1"><mxGeometry x="40" y="305" width="1120" height="235" as="geometry" /></mxCell><mxCell id="m1" parent="1" value="Exp1&lt;br/&gt;&lt;b&gt;ResNet baseline&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:12px;font-weight:0;&#x27;&gt;构建传统视觉基线&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#C9C9C9;strokeWidth=1.2;fontSize=13;fontColor=#333333;align=center;verticalAlign=middle;" vertex="1"><mxGeometry x="90" y="375" width="200" height="64" as="geometry" /></mxCell><mxCell id="m2" parent="1" value="Exp2-A&lt;br/&gt;&lt;b&gt;Frozen CLIP image encoder + MLP&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:12px;font-weight:0;&#x27;&gt;验证 CLIP 视觉特征迁移能力&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#C9C9C9;strokeWidth=1.2;fontSize=13;fontColor=#333333;align=center;verticalAlign=middle;" vertex="1"><mxGeometry x="340" y="375" width="235" height="64" as="geometry" /></mxCell><mxCell id="m3" parent="1" value="Exp2-B&lt;br/&gt;&lt;b&gt;CLIP-Adapter&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:12px;font-weight:0;&#x27;&gt;引入轻量特征适配模块&lt;br/&gt;提升任务适配能力&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#C9C9C9;strokeWidth=1.2;fontSize=13;fontColor=#333333;align=center;verticalAlign=middle;" vertex="1"><mxGeometry x="625" y="375" width="200" height="64" as="geometry" /></mxCell><mxCell id="m4" parent="1" value="Exp3&lt;br/&gt;&lt;b&gt;Prompt-Gated CLIP-Adapter&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:12px;font-weight:0;&#x27;&gt;利用固定提示词与门控机制&lt;br/&gt;探索语义辅助作用&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#C9C9C9;strokeWidth=1.2;fontSize=13;fontColor=#333333;align=center;verticalAlign=middle;" vertex="1"><mxGeometry x="875" y="375" width="235" height="64" as="geometry" /></mxCell><mxCell id="note1" parent="1" value="统一训练设置：15 个 epoch · Adam 优化器 · L1 损失 · 相同数据划分" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#C9C9C9;strokeWidth=1.2;fontSize=13;fontColor=#333333;align=center;verticalAlign=middle;" vertex="1"><mxGeometry x="290" y="470" width="620" height="42" as="geometry" /></mxCell><mxCell id="panel3" parent="1" value="实验分析与论文结论" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#EDEDED;strokeColor=#B7B7B7;strokeWidth=1.5;fontSize=18;fontStyle=1;fontColor=#111111;align=center;verticalAlign=top;spacingTop=10;" vertex="1"><mxGeometry x="40" y="580" width="1120" height="190" as="geometry" /></mxCell><mxCell id="a1" parent="1" value="主实验对比&lt;br/&gt;&lt;font style=&#x27;font-size:12px;font-weight:0;&#x27;&gt;比较 ResNet baseline、Frozen CLIP、CLIP-Adapter 与 Prompt-Gated CLIP-Adapter&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#C9C9C9;strokeWidth=1.2;fontSize=13;fontColor=#333333;align=center;verticalAlign=middle;" vertex="1"><mxGeometry x="90" y="650" width="250" height="68" as="geometry" /></mxCell><mxCell id="a2" parent="1" value="固定提示词消融实验&lt;br/&gt;&lt;font style=&#x27;font-size:12px;font-weight:0;&#x27;&gt;Full prompts / Direction-only prompts / Prompt concat / Prompt gate&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#C9C9C9;strokeWidth=1.2;fontSize=13;fontColor=#333333;align=center;verticalAlign=middle;" vertex="1"><mxGeometry x="380" y="650" width="250" height="68" as="geometry" /></mxCell><mxCell id="a3" parent="1" value="核心实验结论&lt;br/&gt;&lt;font style=&#x27;font-size:12px;font-weight:0;&#x27;&gt;CLIP 视觉迁移有效&lt;br/&gt;CLIP-Adapter 平均结果最优&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#C9C9C9;strokeWidth=1.2;fontSize=13;fontColor=#333333;align=center;verticalAlign=middle;" vertex="1"><mxGeometry x="670" y="650" width="210" height="68" as="geometry" /></mxCell><mxCell id="a4" parent="1" value="最终论文结论&lt;br/&gt;&lt;font style=&#x27;font-size:12px;font-weight:0;&#x27;&gt;固定提示词能提供一定语义辅助&lt;br/&gt;但对连续回归任务仍存在明显局限&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#C9C9C9;strokeWidth=1.2;fontSize=13;fontColor=#333333;align=center;verticalAlign=middle;" vertex="1"><mxGeometry x="915" y="650" width="195" height="68" as="geometry" /></mxCell><mxCell id="foot" parent="1" value="总体研究逻辑：数据集与协议设置 → 递进式模型设计 → 主实验与消融分析 → 结论与展望" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#E6E6E6;strokeColor=#B7B7B7;strokeWidth=1.5;fontSize=18;fontStyle=1;fontColor=#111111;align=center;verticalAlign=middle;" vertex="1"><mxGeometry x="180" y="795" width="840" height="44" as="geometry" /></mxCell><mxCell id="e1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#333333;strokeWidth=1.8;endArrow=block;endFill=1;" edge="1" source="title" target="sec1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#333333;strokeWidth=1.8;endArrow=block;endFill=1;" edge="1" source="sec1" target="p1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e3" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#333333;strokeWidth=1.8;endArrow=block;endFill=1;" edge="1" source="sec1" target="p2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e4" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor