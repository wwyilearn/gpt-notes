" as="geometry" /></mxCell><mxCell id="m3" value="Exp2-B&lt;br/&gt;&lt;b&gt;CLIP-Adapter&lt;/b&gt;&lt;br/&gt;Lightweight feature adaptation" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;strokeColor=#72A46A;strokeWidth=1.4;fillColor=#EAF7E8;fontSize=12;fontColor=#24313F;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="560" y="315" width="170" height="65" as="geometry" /></mxCell><mxCell id="m4" value="Exp3&lt;br/&gt;&lt;b&gt;Prompt-Gated CLIP-Adapter&lt;/b&gt;&lt;br/&gt;Explore fixed-prompt semantic guidance" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;strokeColor=#72A46A;strokeWidth=1.4;fillColor=#EAF7E8;fontSize=12;fontColor=#24313F;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="790" y="315" width="220" height="65" as="geometry" /></mxCell><mxCell id="n21" value="Same data split&lt;br/&gt;Same training epochs&lt;br/&gt;Same loss and metric" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeColor=#9AA8B6;strokeWidth=1.0;fillColor=#FFFFFF;fontSize=11;fontColor=#24313F;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="415" y="265" width="170" height="36" as="geometry" /></mxCell><mxCell id="n22" value="Main comparison focuses on fair relative performance under the same setting" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeColor=#9AA8B6;strokeWidth=1.0;fillColor=#FFFFFF;fontSize=11;fontColor=#24313F;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="370" y="390" width="310" height="36" as="geometry" /></mxCell><mxCell id="a1" value="Main experiments&lt;br/&gt;Compare the four representative methods under the same three subject splits" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;strokeColor=#B98593;strokeWidth=1.4;fillColor=#FBECEF;fontSize=12;fontColor=#24313F;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="80" y="495" width="230" height="68" as="geometry" /></mxCell><mxCell id="a2" value="Prompt ablation&lt;br/&gt