  <diagram id="techroute_color_cn" name="彩色中文技术路线图">
    <mxGraphModel dx="1386" dy="819" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="950" math="0" shadow="0">
      <root>
        <mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" parent="1" value="基于 CLIP 与提示词的三维注视估计技术路线图" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#DCE9F7;strokeColor=#8AA9C7;strokeWidth=1.6;fontSize=22;fontStyle=1;fontColor=#1F2D3D;align=center;verticalAlign=middle;" vertex="1"><mxGeometry x="35" y="18" width="1130" height="50" as="geometry" /></mxCell><mxCell id="sec1" parent="1" value="研究背景与问题分析&lt;br/&gt;&lt;font style=&#x27;font-size:13px;color:#5F6B77;&#x27;&gt;传统模型跨受试者泛化有限；CLIP 视觉特征具有迁移潜力；固定提示词对连续回归任务的表达能力仍待验证&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#E9EEF3;strokeColor=#B8C2CC;strokeWidth=1.5;fontSize=18;fontStyle=1;fontColor=#1F2D3D;align=center;verticalAlign=middle;" vertex="1"><mxGeometry x="90" y="92" width="1020" height="58" as="geometry" /></mxCell><mxCell id="b1" parent="1" value="数据基础&lt;br/&gt;&lt;font style=&#x27;font-size:13px;font-weight:0;&#x27;&gt;MPIIFaceGaze 数据集&lt;br/&gt;全脸图像、pose、gaze 标签&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#EAF3FF;strokeColor=#8FAFD1;strokeWidth=1.4;fontSize=15;fontStyle=1;fontColor=#203040;align=center;verticalAlign=middle;" vertex="1"><mxGeometry x="40" y="190" width="300" height="82" as="geometry" /></mxCell><mxCell id="b2" parent="1" value="实验设置&lt;br/&gt;&lt;font style=&#x27;font-size:13px;font-weight:0;&#x27;&gt;224×224 输入尺寸&lt;br/&gt;CLIP 归一化&lt;br/&gt;简化版 LOPO（test_id=0/1/2）&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFF6E3;strokeColor=#D0B071;strokeWidth=1.4;fontSize=15;fontStyle=1;fontColor=#203040;align=center;verticalAlign=middle;" vertex="1"><mxGeometry x="450" y="190" width="300" height="82" as="geometry" /></mxCell><mxCell id="b3" parent="1" value="任务目标&lt;br/&gt;&lt;font style=&#x27;font-size:13px;font-weight:0;&#x27;&gt;输出 yaw / pitch&lt;br/&gt;采用平均角度误差评价最终三维注视方向&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#EDF8EA;strokeColor=#8DB185;strokeWidth=1.4;fontSize=15;fontStyle=1;fontColor=#203040;align=center;verticalAlign=middle;" vertex="1"><mxGeometry x="860" y="190" width="270" height="82" as="geometry" /></mxCell><mxCell id="panel2" parent="1" value="递进式模型设计与核心实验框架" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F4F6F8;strokeColor=#C3CBD4;strokeWidth=1.6;fontSize=18;fontStyle=1;fontColor=#1F2D3D;align=center;verticalAlign=top;spacingTop=10;" vertex="1"><mxGeometry x="35" y="315" width="1130" height="255" as="geometry" /></mxCell><mxCell id="m1" parent="1" value="Exp1&lt;br/&gt;&lt;b&gt;ResNet baseline&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:12px;font-weight:0;&#x27;&gt;构建传统视觉基线&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=9;fillColor=#F7FBFF;strokeColor=#9DB9D7;strokeWidth=1.2;fontSize=13;fontColor=#24313F;align=center;verticalAlign=middle;" vertex="1"><mxGeometry x="70" y="390" width="190" height="66" as="geometry" /></mxCell><mxCell id="m2" parent="1" value="Exp2-A&lt;br/&gt;&lt;b&gt;Frozen CLIP image encoder + MLP&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:12px;font-weight:0;&#x27;&gt;验证 CLIP 视觉特征迁移能力&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=9;fillColor=#F7FCF5;strokeColor=#A9C7A3;strokeWidth=1.2;fontSize=13;fontColor=#24313F;align=center;verticalAlign=middle;" vertex="1"><mxGeometry x="310" y="390" width="245" height="66" as="geometry" /></mxCell><mxCell id="m3" parent="1" value="Exp2-B&lt;br/&gt;&lt;b&gt;CLIP-Adapter&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:12px;font-weight:0;&#x27;&gt;引入轻量特征适配模块&lt;br/&gt;增强任务适配能力&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=9;fillColor=#FFF7F8;strokeColor=#D2A5AE;strokeWidth=1.2;fontSize=13;fontColor=#24313F;align=center;verticalAlign=middle;" vertex="1"><mxGeometry x="605" y="390" width="220" height="66" as="geometry" /></mxCell><mxCell id="m4" parent="1" value="Exp3&lt;br/&gt;&lt;b&gt;Prompt-Gated CLIP-Adapter&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:12px;font-weight:0;&#x27;&gt;利用固定提示词与门控机制&lt;br/&gt;探索语义辅助作用&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=9;fillColor=#F8F5FF;strokeColor=#B6A6D8;strokeWidth=1.2;fontSize=13;fontColor=#24313F;align=center;verticalAlign=middle;" vertex="1"><mxGeometry x="875" y="390" width="240" height="66" as="geometry" /></mxCell><mxCell id="n1" parent="1" value="统一训练设置：15 个 epoch · Adam 优化器 · L1 损失 · 相同数据划分" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#C8D0D8;strokeWidth=1.0;fontSize=12;fontColor=#44515E;align=center;verticalAlign=middle;" vertex="1"><mxGeometry x="280" y="480" width="640" height="38" as="geometry" /></mxCell><mxCell id="n2" parent="1" value="主实验用于比较不同模型的相对性能；提示词相关实验用于分析固定提示词的实际作用与局限" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#C8D0D8;strokeWidth=1.0;fontSize=12;fontColor=#44515E;align=center;verticalAlign=middle;" vertex="1"><mxGeometry x="190" y="528" width="820" height="32" as="geometry" /></mxCell><mxCell id="panel3" parent="1" value="实验分析、论文结论与研究输出" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F4F6F8;strokeColor=#C3CBD4;strokeWidth=1.6;fontSize=18;fontStyle=1;fontColor=#1F2D3D;align=center;verticalAlign=top;spacingTop=10;" vertex="1"><mxGeometry x="35" y="602" width="1130" height="220" as="geometry" /></mxCell><mxCell id="a1" parent="1" value="主实验结果分析&lt;br/&gt;&lt;font style=&#x27;font-size:12px;font-weight:0;&#x27;&gt;比较 ResNet baseline、Frozen CLIP、CLIP-Adapter 与 Prompt-Gated CLIP-Adapter&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=9;fillColor=#F7FBFF;strokeColor=#9DB9D7;strokeWidth=1.2;fontSize=13;fontColor=#24313F;align=center;verticalAlign=middle;" vertex="1"><mxGeometry x="70" y="680" width="255" height="74" as="geometry" /></mxCell><mxCell id="a2" parent="1" value="固定提示词消融实验&lt;br/&gt;&lt;font style=&#x27;font-size:12px;font-weight:0;&#x27;&gt;Full prompts / Direction-only prompts / Prompt concat / Prompt gate&lt;/font&gt;" style="rou